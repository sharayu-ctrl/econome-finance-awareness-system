# EconoMe — Environment Variables Example
# Phase 10: Copy this to .env and fill in your values.

# ── App ───────────────────────────────────────────────────────────────────────
ENV=development
SECRET_KEY=your-32-byte-random-secret-key-here
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["*"]

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=mysql+aiomysql://econome:econome@localhost:3306/econome

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── JWT (RS256) — generate with: openssl genrsa -out keys/private.pem 2048
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ── Encryption ────────────────────────────────────────────────────────────────
# 32-byte key, base64-encoded: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MASTER_ENCRYPTION_KEY=your-32-byte-base64-encoded-master-key

# ── AI ────────────────────────────────────────────────────────────────────────
LOCAL_LLM_ENABLED=false
LOCAL_LLM_MODEL_PATH=models/mistral-7b-q4.gguf
ONNX_MODEL_PATH=models/expense_categorizer.onnx
LLM_CONFIDENCE_THRESHOLD=0.75

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=econome-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Blockchain (Polygon L2) ───────────────────────────────────────────────────
BLOCKCHAIN_ENABLED=false
POLYGON_RPC_URL=https://polygon-rpc.com
SMART_CONTRACT_ADDRESS=
BLOCKCHAIN_WALLET_PRIVATE_KEY=

# ── External APIs ─────────────────────────────────────────────────────────────
OPEN_EXCHANGE_RATES_KEY=
EIA_API_KEY=
