{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Run Dev Server",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host", "0.0.0.0",
        "--port", "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "envFile": "${workspaceFolder}/backend/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Celery: Run Worker",
      "type": "python",
      "request": "launch",
      "module": "celery",
      "args": [
        "-A", "workers.tasks.celery_app",
        "worker",
        "--loglevel=info",
        "-Q", "high,low,default"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "envFile": "${workspaceFolder}/backend/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Celery: Run Beat Scheduler",
      "type": "python",
      "request": "launch",
      "module": "celery",
      "args": [
        "-A", "workers.tasks.celery_app",
        "beat",
        "--loglevel=info"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "envFile": "${workspaceFolder}/backend/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest: Run All Tests",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/",
        "-v",
        "--tb=short"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend",
        "ENV": "test",
        "DATABASE_URL": "mysql+aiomysql://econome:econome@localhost:3306/econome",
        "REDIS_URL": "redis://localhost:6379/0",
        "MASTER_ENCRYPTION_KEY": "dGVzdGtleWZvcnRlc3Rpbmd0ZXN0a2V5Zm9ydA==",
        "JWT_PRIVATE_KEY_PATH": "keys/private.pem",
        "JWT_PUBLIC_KEY_PATH": "keys/public.pem"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Seed: Populate Database",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/backend/seed.py",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: API + Worker",
      "configurations": ["FastAPI: Run Dev Server", "Celery: Run Worker"],
      "stopAll": true
    }
  ]
}
